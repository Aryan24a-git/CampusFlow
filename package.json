{
  "name": "campusflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=backend\"",
    "build": "npm run build --workspace=apps/web && npm run build --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
